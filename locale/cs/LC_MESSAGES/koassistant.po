msgstr "V této kategorii nejsou další pojmenované položky ke sloučení."

#: koassistant_xray_dedup.lua:1067 koassistant_xray_dedup.lua:1091
msgid "Pick the entry to pair with \"%1\""
msgstr "Vyberte položku do dvojice s „%1“"

#: koassistant_xray_dedup.lua:1089
msgid "Pick the entry to KEEP or merge into"
msgstr "Vyberte položku, kterou ZACHOVAT nebo do které sloučit"

#: koassistant_xray_dedup.lua:1108
msgid "Merge entities manually: pick a category"
msgstr "Sloučit entity ručně: vyberte kategorii"

#: koassistant_xray_dedup.lua:1126 koassistant_xray_dedup.lua:1161
msgid "No more likely duplicates."
msgstr "Žádné další pravděpodobné duplicity."

#: koassistant_xray_dedup.lua:1127 koassistant_xray_dedup.lua:1162
msgid "No likely duplicates found."
msgstr "Nebyly nalezeny žádné pravděpodobné duplicity."

#: koassistant_xray_dedup.lua:1129 koassistant_xray_dedup.lua:1183
msgid "Merge two entities manually…"
msgstr "Sloučit dvě entity ručně…"

#: koassistant_xray_dedup.lua:1150
msgid "%1 ↔ %2 (%3)"
msgstr "%1 ↔ %2 (%3)"

#: koassistant_xray_dedup.lua:1168
msgid "Showing the first %1: resolve some to see more"
msgstr "Zobrazeno prvních %1 — vyřešte některé pro zobrazení dalších"

#: koassistant_xray_dedup.lua:1174
msgid "Never-merge pairs (%1)…"
msgstr "Dvojice, které neslučovat (%1)…"

#: koassistant_xray_dedup.lua:1194
msgid "Possible duplicate entities (%1)"
msgstr "Možné duplicitní entity (%1)"

#: koassistant_xray_index.lua:676
