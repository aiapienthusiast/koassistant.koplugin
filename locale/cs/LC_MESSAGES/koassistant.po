msgid ""
"Never suggest merging \"%1\" and \"%2\"?\n"
"\n"
"This is remembered for this book (you can undo it under \"Never-merge pairs\" in the duplicates list)."
msgstr ""
"Nikdy nenavrhovat sloučení „%1“ a „%2“?\n"
"\n"
"Volba se pamatuje pro tuto knihu (můžete ji zrušit v části „Dvojice, které "
"neslučovat“ v seznamu duplicit)."

#: koassistant_xray_dedup.lua:968
msgid "Allow suggesting \"%1\" and \"%2\" as duplicates again?"
msgstr "Znovu povolit navrhování „%1“ a „%2“ jako duplicit?"

#: koassistant_xray_dedup.lua:970
