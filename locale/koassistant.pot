#: koassistant/ui/prompts_manager.lua:2228
#: koassistant/ui/prompts_manager.lua:2285
msgid "Translate"
msgstr ""

#: koassistant/prompts/actions.lua:2543
msgid ""
"Translates the selected text into your configured translation language. This "
"action also controls the Translate Current Page function."
msgstr ""

#: koassistant/prompts/actions.lua:2563
msgid "Quick Define"
msgstr ""

#: koassistant/prompts/actions.lua:2564
msgid ""
"A brief, one-line dictionary definition of the selected word in your "
"dictionary language."
msgstr ""

#: koassistant/prompts/actions.lua:2596 koassistant/ui/chatgptviewer.lua:4282
#: koassistant/ui/prompts_manager.lua:2208
#: koassistant/ui/prompts_manager.lua:2226
#: koassistant/ui/prompts_manager.lua:2283
msgid "Dictionary"
msgstr ""

#: koassistant/prompts/actions.lua:2597
msgid ""
"Full dictionary entry with pronunciation, definitions, etymology, and "
"synonyms."
msgstr ""

#: koassistant/prompts/actions.lua:2630
msgid "Deep Analysis"
msgstr ""

#: koassistant/prompts/actions.lua:2631
msgid ""
"Deep linguistic analysis covering morphology, word family, etymology, "
"cognates, and cross-language borrowings. Adapts to the word's language "
"family (Semitic roots, Indo-European stems, etc.)."
msgstr ""

