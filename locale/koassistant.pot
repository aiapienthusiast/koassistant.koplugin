#: koassistant/ui/settings_schema.lua:842
msgid ""
"Where to save exported chat files. Creates subfolders for book/general/multi-"
"book chats.\n"
"\n"
"Default folder:\n"
"%1"
msgstr ""

#: koassistant/ui/settings_schema.lua:858
msgid "Save book chats alongside books"
msgstr ""

#: koassistant/ui/settings_schema.lua:861
msgid ""
"When enabled, book chats are saved to a 'chats' subfolder next to the book "
"file instead of the central location."
msgstr ""

#: koassistant/ui/settings_schema.lua:873
msgid "Reading & Library"
msgstr ""

#: koassistant/ui/settings_schema.lua:882
msgid "Chapter Quiz: %1"
msgstr ""

#: koassistant/ui/settings_schema.lua:889
msgid "Quiz on Chapter End"
msgstr ""

#: koassistant/ui/settings_schema.lua:892
msgid ""
"Offer a comprehension quiz when you finish reading a chapter. Requires a "
"book with a table of contents."
msgstr ""

#: koassistant/ui/settings_schema.lua:897
msgid "Quiz Chapter Level"
msgstr ""

#: koassistant/ui/settings_schema.lua:907
msgid ""
"Which TOC level counts as a 'chapter' for end-of-chapter quizzes. A fixed "
"level falls back to the deepest level the book actually has. 'Auto-detect' "
"picks the deepest level whose chapters are at least the minimum length "
"below. 'All TOC headings' follows KOReader's TOC tick settings. Short or "
"skimmed chapters are skipped by the length setting below."
msgstr ""

#: koassistant/ui/settings_schema.lua:913
msgid "Minimum Chapter Length (pages)"
msgstr ""

#: koassistant/ui/settings_schema.lua:920
msgid ""
"Skip the chapter-end quiz for chapters shorter than this many pages (0 = no "
"minimum). Also sets the threshold 'Auto-detect' uses to pick the chapter "
"level. Can be overridden per book in Book Settings."
msgstr ""

#: koassistant/ui/settings_schema.lua:926
msgid "Minimum Reading Time (minutes)"
msgstr ""

#: koassistant/ui/settings_schema.lua:933
msgid ""
"Skip the chapter-end quiz unless you spent at least this many minutes "
"reading the chapter (0 = no minimum). Catches flipping quickly through a "
"long chapter. Uses KOReader's reading statistics; if those are unavailable "
"the quiz is still offered. Can be overridden per book in Book Settings."
msgstr ""

#: koassistant/ui/settings_schema.lua:939
msgid "Question Count"
msgstr ""

#: koassistant/ui/settings_schema.lua:946
msgid "Total number of questions to generate per quiz."
msgstr ""

#: koassistant/ui/settings_schema.lua:951
msgid "Difficulty"
msgstr ""

#: koassistant/ui/settings_schema.lua:959
msgid ""
"Easy: straightforward recall. Medium: comprehension and application. Hard: "
"analysis and synthesis."
msgstr ""

#: koassistant/ui/settings_schema.lua:964
msgid "Include Multiple Choice"
msgstr ""

#: koassistant/ui/settings_schema.lua:971
msgid "Include Short Answer"
msgstr ""

#: koassistant/ui/settings_schema.lua:978
msgid "Include Discussion"
msgstr ""

#: koassistant/ui/settings_schema.lua:994
msgid "Automatic X-Ray (all books)"
msgstr ""

#: koassistant/ui/settings_schema.lua:997
msgid ""
"Keep the X-Rays you started up to date as you read (flowing formats like "
"EPUB only): checkpoints at chapter-sized steps, always keeping the next "
"checkpoint ready ahead of you; reaching it installs it instantly and the one "
"after starts building. Books with no X-Ray are left alone: start one from "
"the X-Ray popup with \"In checkpoints, as I read (automatic)\", or switch a "
"book to Automatic individually (X-Ray popup or Book Settings → X-Ray → "
"Automatic X-Ray), which works even with this off; a per-book Off always "
"wins.\n"
"\n"
"Spend guards: a cooldown before retrying a step that was declined, failed or "
"cancelled, WiFi only, and the book's text allowed for the book, or a trusted "
"provider (a book on Ask is asked once); background runs extract book text "
"and use API tokens without a per-request tap. Leave off if every request "
"should be explicit."
msgstr ""

#: koassistant/ui/settings_schema.lua:1023
msgid "Cooldown (minutes)"
msgstr ""

#: koassistant/ui/settings_schema.lua:1030
msgid ""
"Minimum wait before retrying an automatic checkpoint after one was declined, "
"failed or cancelled (0 = no cooldown). A completed build does not wait."
msgstr ""

#: koassistant/ui/settings_schema.lua:1036
msgid "Notify on Background Activity"
msgstr ""

#: koassistant/ui/settings_schema.lua:1039
msgid ""
"Show a brief notification when a background X-Ray update or create starts "
"and completes, and when a checkpoint is silently swapped in. Off = fully "
"silent (the X-Ray popup always shows the current coverage)."
msgstr ""

#: koassistant/ui/settings_schema.lua:1045
msgid "Checkpoints at Chapter Ends"
msgstr ""

#: koassistant/ui/settings_schema.lua:1048
msgid ""
"When building X-Ray checkpoints, place each checkpoint at the nearest "
"chapter end (within a few percent) instead of an exact percentage; "
"checkpoints then read as \"up to the end of a chapter\", and the versions "
"list shows the chapter names. Needs a table of contents. Checkpoint spacing "
"itself adapts to book length: about every 10% of a normal-length book, "
"larger steps for short ones."
msgstr ""

#: koassistant/ui/settings_schema.lua:1053
msgid "Preset for New X-Rays"
msgstr ""

#: koassistant/ui/settings_schema.lua:1056
msgid ""
"One tap for the three settings below it: what a new X-Ray tracks, whether it "
"keeps the status block (\"Where things stand\"), and how much each entry "
"carries. Characters only is the cheapest (the cast, no status block); "
"Reference is the default (people, places, ideas and terms); Everything adds "
"the story arc; Light companion and Deep study change the depth as well. Each "
"setting can still be changed on its own; the preset then reads Custom. A "
"book can pick its own preset in Book Settings and a group in its Group "
"Settings. Applies when an X-Ray is created or rebuilt."
msgstr ""

#: koassistant/ui/settings_schema.lua:1061
msgid "Categories for New X-Rays"
msgstr ""

#: koassistant/ui/settings_schema.lua:1064
msgid ""
"Which category groups a new X-Ray tracks by default. Reference (everything "
"except the timeline) unless changed here; All categories adds the timeline "
"or argument development, Characters only is the lightest. The last checkbox, "
"\"Where things stand\", is the status block (current state, or the "
"conclusion of a whole-book X-Ray): every update rewrites it, so an X-Ray "
"without it has shorter updates. Applies when an X-Ray is created or rebuilt; "
"individual books can pick their own categories in Book Settings."
msgstr ""

#: koassistant/ui/settings_schema.lua:1069
msgid "Depth of New X-Rays"
msgstr ""

#: koassistant/ui/settings_schema.lua:1072
msgid ""
"How much each X-Ray entry carries by default. Light: one line per entry, "
"only recurring figures and turning points, about half the cost. Standard: a "
"few sentences per entry, everything the reader meets. Deep: longer entries, "
"every figure and development, richer connections. Applies when an X-Ray is "
"created or rebuilt; checkpoints and updates keep the depth the X-Ray was "
"started with. Individual books can pick their own depth in Book Settings."
msgstr ""

#: koassistant/ui/settings_schema.lua:1077
msgid "Type of New X-Rays"
msgstr ""

#: koassistant/ui/settings_schema.lua:1080
msgid ""
"Whether a new X-Ray uses the fiction schema (characters, places, story), the "
"nonfiction one (people, concepts, argument) or the academic one (concepts, "
"methods, findings, cited works). Auto, the default, lets the AI decide from "
"the work. Applies when an X-Ray is created or rebuilt; updates keep the X-"
"Ray's own type. Individual books can pick their own type in Book Settings, "
"which is where a book whose X-Ray came out as the wrong type is fixed."
msgstr ""

#: koassistant/ui/settings_schema.lua:1085
msgid "Carried Entries"
msgstr ""

#: koassistant/ui/settings_schema.lua:1088
msgid ""
"In a series or project group, entries from the group's other books that have "
"not appeared in the open book yet are carried along (in a series: from the "
"earlier books only). They always have their own list, \"Carried from earlier "
"books\". This sets whether they are also listed inside the X-Ray's own "
"categories, after the book's own entries, with the book each one comes from "
"beside it (the default), or on that list only. A group can set this for all "
"its books in its Group Settings, and a book in Book Settings. It changes the "
"lists only: nothing is sent and no X-Ray is rebuilt."
msgstr ""

#: koassistant/ui/settings_schema.lua:1093
msgid "X-Ray Entry for Matching Selections"
msgstr ""

#: koassistant/ui/settings_schema.lua:1096
msgid ""
"When a tapped word or selected text exactly matches an X-Ray entity's name "
"or alias, open that X-Ray entry directly, skipping ahead of the dictionary "
"and the highlight menu (including any bypass actions you have set there). "
"Anything that doesn't match falls through to your normal dictionary/"
"highlight behavior. Only does anything for books that have an X-Ray. A very "
"long press at the end of a selection always shows the normal highlight menu."
msgstr ""

#: koassistant/ui/settings_schema.lua:1114
msgid ""
"Discreetly underline words on the page that match an X-Ray entity's name or "
"alias, as you read (dotted gray, drawn shortly after the page settles; "
"entirely on-device). Tap a marked word to open its entry. Only active for "
"books that have an X-Ray. EPUB page mode only."
msgstr ""

#: koassistant/ui/settings_schema.lua:1127
msgid "Tap Marked Words to Open"
msgstr ""

#: koassistant/ui/settings_schema.lua:1130
msgid ""
"With passive marking on, a plain tap on a marked word opens its X-Ray entry, "
"like a link (real links in the text still win). Off = marks are visual only; "
"a long press still opens matching entries via \"X-Ray Entry for Matching "
"Selections\"."
msgstr ""

#: koassistant/ui/settings_schema.lua:1146
msgid ""
"Let marking, matching selections and entity cards recognize entities that "
"first appear past your installed X-Ray coverage, using only the next "
"checkpoint built past your reading position (never a later one). "
"Identification only: such names get short-dash marks and a card that, by "
"default, shows just the tapped name until you ask for the entry. Off = the "
"plugin only knows entities up to your installed coverage."
msgstr ""

#: koassistant/ui/settings_schema.lua:1161
msgid "Upcoming Entity Cards: %1"
msgstr ""

#: koassistant/ui/settings_schema.lua:1167
msgid "Name only, tap to show a one-line description"
msgstr ""

#: koassistant/ui/settings_schema.lua:1170
msgid ""
"What the card shows first for an upcoming entity, known only from the next "
"checkpoint built ahead of you. Name only shows the tapped name and its "
"category; a tap on the card adds the entry's first sentence, and another tap "
"opens the full entry behind a spoiler confirmation. First sentence right "
"away skips the first step (it can reveal that a name is another character's "
"alias). Can be overridden per book."
msgstr ""

#: koassistant/ui/settings_schema.lua:1181
msgid "Card Shows: %1"
msgstr ""

#: koassistant/ui/settings_schema.lua:1187
msgid "First sentence only"
msgstr ""

#: koassistant/ui/settings_schema.lua:1190
msgid ""
"How much of an entry the card shows for entities already in your installed X-"
"Ray. First sentence keeps the card to a one-line identification, with the "
"full entry a tap away. Full entry shows the whole description (swipe to "
"scroll the footnote panel; the floating popup cuts it where it runs out of "
"room). Can be overridden per book."
msgstr ""

#: koassistant/ui/settings_schema.lua:1195
msgid "Entity Card First"
msgstr ""

#: koassistant/ui/settings_schema.lua:1198
msgid ""
"Exact entity hits (tapping a marked word, or selecting text that matches an "
"entity) open a compact card first: the name, category and role, and a one-"
"line identification, with the full entry a tap on the card away. The "
"identification may come from the newest built checkpoint, so newly appearing "
"names are known on sight; the full entry stays at your reading position, "
"behind a confirmation, while spoiler protection is on. Off = open the full "
"entry directly."
msgstr ""

#: koassistant/ui/settings_schema.lua:1215
msgid "Footnote Panel"
msgstr ""

#: koassistant/ui/settings_schema.lua:1216
msgid "Floating Popup"
msgstr ""

#: koassistant/ui/settings_schema.lua:1218
msgid "Card Style: %1"
msgstr ""

#: koassistant/ui/settings_schema.lua:1223
msgid "Footnote panel (bottom of the screen)"
msgstr ""

#: koassistant/ui/settings_schema.lua:1224
msgid "Floating popup (near the tapped word)"
msgstr ""

#: koassistant/ui/settings_schema.lua:1226
msgid ""
"How the entity card is presented. The footnote panel slides in at the bottom "
"of the screen, like KOReader's footnote popups, and follows the book's "
"margins and font size. The floating popup is a small window anchored next to "
"the tapped word. In both, tapping the card opens the full entry; tapping "
"elsewhere dismisses it."
msgstr ""

#: koassistant/ui/settings_schema.lua:1235
msgid "All Occurrences"
msgstr ""

#: koassistant/ui/settings_schema.lua:1236
msgid "Once per Page"
msgstr ""

#: koassistant/ui/settings_schema.lua:1237
msgid "After 10 Unseen Pages"
msgstr ""

#: koassistant/ui/settings_schema.lua:1238
msgid "After 25 Unseen Pages"
msgstr ""

#: koassistant/ui/settings_schema.lua:1239
msgid "First Appearance Only"
msgstr ""

#: koassistant/ui/settings_schema.lua:1241
msgid "Marking Density: %1"
msgstr ""

#: koassistant/ui/settings_schema.lua:1247
msgid "Only after 10 unseen pages"
msgstr ""

#: koassistant/ui/settings_schema.lua:1248
msgid "Only after 25 unseen pages"
msgstr ""

#: koassistant/ui/settings_schema.lua:1252
msgid ""
"How often an entity gets marked. Once per page marks its first occurrence on "
"every page it appears. The unseen-pages options re-mark it only after it has "
"been absent that long, so newly returning names stand out while constant "
"companions stay quiet. First appearance marks it once in the whole book; all "
"occurrences marks every one."
msgstr ""

#: koassistant/ui/settings_schema.lua:1269
msgid "All Entities"
msgstr ""

#: koassistant/ui/settings_schema.lua:1270
msgid "People Only"
msgstr ""

#: koassistant/ui/settings_schema.lua:1271
msgid "People & Places"
msgstr ""

#: koassistant/ui/settings_schema.lua:1273
msgid "Mark: %1"
msgstr ""

#: koassistant/ui/settings_schema.lua:1280
msgid "People and places"
msgstr ""

#: koassistant/ui/settings_schema.lua:1282
msgid ""
"Which kinds of X-Ray entities get marked on the page. People covers "
"characters and key figures; places adds locations."
msgstr ""

#: koassistant/ui/settings_schema.lua:1298
msgid "Chapter Appearances Rows: %1"
msgstr ""

#: koassistant/ui/settings_schema.lua:1299
msgid "KOReader ToC Settings"
msgstr ""

#: koassistant/ui/settings_schema.lua:1299
msgid "Compact"
msgstr ""

#: koassistant/ui/settings_schema.lua:1304
msgid "Compact (20 rows per page)"
msgstr ""

#: koassistant/ui/settings_schema.lua:1305
msgid "Follow KOReader's ToC settings"
msgstr ""

#: koassistant/ui/settings_schema.lua:1307
msgid ""
"Row density for the Chapter Appearances tree in the X-Ray browser. Compact "
"fits 20 rows per page; the other option follows KOReader's own Table of "
"Contents items-per-page and font-size settings."
msgstr ""

#: koassistant/ui/settings_schema.lua:1313
msgid "X-Ray Versions to Keep"
msgstr ""

#: koassistant/ui/settings_schema.lua:1320
msgid ""
"Whenever an update or redo overwrites the X-Ray, the outgoing version is "
"archived: browse, view, or restore them via \"All versions\" in the X-Ray "
"popup and browser menu. This sets how many are kept per book; the versions "
"covering the least of the book are dropped first, oldest first among equally "
"covering ones. 0 stops archiving new versions; already-archived ones stay "
"until you delete them or the X-Ray itself. Checkpoints are stored separately "
"and are never trimmed by this."
msgstr ""

#: koassistant/ui/settings_schema.lua:1326
msgid "Connection Buttons per Entry"
msgstr ""

#: koassistant/ui/settings_schema.lua:1333
msgid ""
"An entity page turns each of its connections into a tappable button. A "
"richly connected character can carry dozens, which crowd the description off "
"the screen. This caps how many BOXES the connection block may use: past it "
"the last box becomes an overflow row opening the full list. At or under it "
"every connection is drawn and the list lives in the entry's More menu. "
"Repeated links to the same entity are always collapsed, whatever this is set "
"to. 0 draws no buttons and lists every connection instead."
msgstr ""

#: koassistant/ui/settings_schema.lua:1342
msgid ""
"Mirrors the Spoiler Protection setting in Chat & Export Settings. It also "
"lives here because it steers X-Ray updates: when on, checkpoint installs "
"follow your reading position; when off, the newest built checkpoint installs "
"right away. Override per book in Book Settings (the Spoiler Protection and X-"
"Ray updates rows)."
msgstr ""

#: koassistant/ui/settings_schema.lua:1350
msgid "Recap Reminder"
msgstr ""

#: koassistant/ui/settings_schema.lua:1355
msgid "Remind to Recap on Book Open"
msgstr ""

#: koassistant/ui/settings_schema.lua:1358
msgid ""
"Show a reminder to run Recap when you open a book you haven't read in a "
"while."
msgstr ""

#: koassistant/ui/settings_schema.lua:1363
msgid "Days Before Reminder"
msgstr ""

#: koassistant/ui/settings_schema.lua:1370
msgid "Number of days since last reading before the reminder appears."
msgstr ""

#: koassistant/ui/settings_schema.lua:1378
msgid "End of Book"
msgstr ""

#: koassistant/ui/settings_schema.lua:1383
msgid "Suggest Next Read on Finish"
msgstr ""

#: koassistant/ui/settings_schema.lua:1386
msgid ""
"When you reach the end of a book, offer to suggest what to read next from "
"your library. Requires your book list allowed (Ask asks first) and at least "
"one permanent scan folder."
msgstr ""

#: koassistant/ui/settings_schema.lua:1402
msgid ""
"The same value as in Privacy & Data: whether the titles, authors and reading "
"status of the books in your scan folders may go to the AI for the library "
"actions. Ask (the default) asks the first time; Allow sends without a "
"question; Never refuses those actions. Add permanent scan folders below, or "
"pick folders on the fly in the input dialog."
msgstr ""

#: koassistant/ui/settings_schema.lua:1411
msgid "Permanent Scan Folders: None"
msgstr ""

#: koassistant/ui/settings_schema.lua:1413
msgid "Permanent Scan Folders: %1"
msgstr ""

#: koassistant/ui/settings_schema.lua:1420
msgid ""
"Folders always scanned for library actions. You can also pick folders on the "
"fly in the input dialog."
msgstr ""

#: koassistant/ui/settings_schema.lua:1430
msgid "AI Language Settings"
msgstr ""

#: koassistant/ui/settings_schema.lua:1450
msgid "Your Languages: %1 (auto)"
msgstr ""

#: koassistant/ui/settings_schema.lua:1452
msgid "Your Languages: (not set)"
msgstr ""

#: koassistant/ui/settings_schema.lua:1454
#: koassistant/ui/settings_schema.lua:1461
msgid "Your Languages: %1"
msgstr ""

#: koassistant/ui/settings_schema.lua:1471
msgid "Primary Language: (not set)"
msgstr ""

#: koassistant/ui/settings_schema.lua:1473
msgid "Primary Language: %1"
msgstr ""

#: koassistant/ui/settings_schema.lua:1484
msgid "Additional Languages: (none)"
msgstr ""

#: koassistant/ui/settings_schema.lua:1491
msgid "Additional Languages: %1"
msgstr ""

#: koassistant/ui/settings_schema.lua:1498
msgid "Tell the AI the Book's Language"
msgstr ""

#: koassistant/ui/settings_schema.lua:1503
msgid "From the book's metadata"
msgstr ""

#: koassistant/ui/settings_schema.lua:1505
msgid ""
"Off by default: most readers read and chat in one language. When on, book-"
"tool sessions tell the AI what language the book's text is in (from the "
"book's metadata, when recorded) so its searches use that language even if "
"you ask in another. Override per book or group in Book Settings ▸ Languages, "
"where you can also pick or type a language."
msgstr ""

#: koassistant/ui/settings_schema.lua:1514
msgid "Dictionary Settings"
msgstr ""

#: koassistant/ui/settings_schema.lua:1526
msgid "Response Language: (Follow Translation)"
msgstr ""

#: koassistant/ui/settings_schema.lua:1528
msgid "Response Language: (Follow Primary)"
msgstr ""

#: koassistant/ui/settings_schema.lua:1530
msgid "Response Language: %1"
msgstr ""

#: koassistant/ui/settings_schema.lua:1547
msgid "Context Mode: %1"
msgstr ""

#: koassistant/ui/settings_schema.lua:1550
msgid ""
"How much text around the looked-up word is sent with dictionary actions. The "
"Ctx button on the dictionary popup toggles it per lookup; Book Settings can "
"override it per book."
msgstr ""

#: koassistant/ui/settings_schema.lua:1555
#: koassistant/ui/settings_schema.lua:1924
msgid "Context Characters"
msgstr ""

#: koassistant/ui/settings_schema.lua:1561
msgid ""
"Number of characters to include before/after the word when Context Mode is "
"'Characters'"
msgstr ""

#: koassistant/ui/settings_schema.lua:1570
msgid "Show Excerpt"
msgstr ""

#: koassistant/ui/settings_schema.lua:1573
msgid ""
"Show a short excerpt of the text around the looked-up word above the answer, "
"with the word in bold. Only for lookups that send context (Context Mode is "
"not None). Nothing extra is sent. Also on the gear menu of dictionary "
"windows."
msgstr ""

#: koassistant/ui/settings_schema.lua:1578
msgid "Disable Auto-save for Dictionary"
msgstr ""

#: koassistant/ui/settings_schema.lua:1581
msgid ""
"When enabled, dictionary lookups are not auto-saved. When disabled, "
"dictionary chats follow your general chat saving settings. You can always "
"save manually from an expanded view."
msgstr ""

#: koassistant/ui/settings_schema.lua:1590
#: koassistant/ui/settings_schema.lua:1606
#: koassistant/ui/settings_schema.lua:1744
#: koassistant/ui/settings_schema.lua:1760
msgid "Follow global setting"
msgstr ""

#: koassistant/ui/settings_schema.lua:1594
#: koassistant/ui/settings_schema.lua:1610
msgid "Definition only (Recommended)"
msgstr ""

#: koassistant/ui/settings_schema.lua:1597
msgid "What to include when copying in dictionary view."
msgstr ""

#: koassistant/ui/settings_schema.lua:1613
msgid "What to include when saving dictionary results to a note."
msgstr ""

#: koassistant/ui/settings_schema.lua:1621
msgid ""
"Stream dictionary responses in real-time. Disable to wait for complete "
"response."
msgstr ""

#: koassistant/ui/settings_schema.lua:1626
msgid "Bypass KOReader Dictionary"
msgstr ""

#: koassistant/ui/settings_schema.lua:1629
msgid ""
"Skip KOReader's dictionary and go directly to AI when tapping words. Can "
"also be toggled via gesture."
msgstr ""

#: koassistant/ui/settings_schema.lua:1650
#: koassistant/ui/settings_schema.lua:1654
#: koassistant/ui/settings_schema.lua:1656
#: koassistant/ui/settings_schema.lua:1955
#: koassistant/ui/settings_schema.lua:1959
#: koassistant/ui/settings_schema.lua:1961
msgid "Bypass Action: %1"
